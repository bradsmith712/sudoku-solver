{
  "name": "sudoku-photo-solver",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "test": "vitest run --passWithNoTests",
    "test:fast": "vitest run --exclude 'src/vision/*.fixtures.test.ts' --exclude src/vision/memory.test.ts --exclude src/vision/scan.test.ts --exclude '**/*.eval.test.ts'",
    "eval:vision": "EVAL_VISION=1 vitest run src/vision/vision.eval.test.ts tests/eval/end-to-end.eval.test.ts",
    "test:e2e": "playwright test",
    "test:live": "playwright test -c playwright.live.config.ts",
    "lint": "eslint . && prettier --check .",
    "typecheck": "tsc --noEmit",
    "build": "tsc --noEmit && vite build",
    "check": "npm run lint && npm run typecheck && npm test && npm run build",
    "prepare": "git config core.hooksPath .githooks"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@playwright/test": "^1.61.1",
    "@types/node": "^18.19.130",
    "eslint": "^9.39.5",
    "globals": "^17.13.0",
    "jpeg-js": "0.4.4",
    "prettier": "^3.9.10",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.72.0",
    "vite": "^5.4.21",
    "vitest": "^2.1.9"
  },
  "dependencies": {
    "@techstark/opencv-js": "4.12.0-release.1",
    "onnxruntime-web": "1.30.0"
  }
}
